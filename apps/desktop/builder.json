{
  "appId": "pl.nauczpilota.app",
  "productName": "Piko Misja Funkcja",
  "directories": {
    "app": "apps/desktop/staging",
    "output": "release/bin"
  },
  "files": [
    "main.cjs",
    "preload.cjs",
    "distribution.json",
    "relay-validator.cjs",
    "web/**/*",
    "package.json",
    "!node_modules{,/**/*}"
  ],
  "asar": true,
  "npmRebuild": false,
  "win": {
    "target": [
      {
        "target": "zip",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "apps/desktop/icon.ico",
    "signExecutable": false
  },
  "artifactName": "Piko_Misja_Funkcja_${version}_Windows_${arch}.${ext}"
}
