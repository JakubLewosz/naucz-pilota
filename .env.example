# Konfiguracja backendu. Skopiuj do .env lokalnie; nie commituj sekretów.
NODE_ENV=development
SERVER_PORT=3001
PUBLIC_ORIGIN=http://127.0.0.1:5173

# Pierwsze uruchomienie jest jawnym demo. Zmień na live dopiero po konfiguracji.
AI_MODE=demo
# anthropic (domyślnie, Claude) albo openai.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
# Claude: low | medium | high | xhigh | max. Medium daje szybkie odpowiedzi w grze.
AI_REASONING_EFFORT=medium
# Wariant OpenAI: AI_PROVIDER=openai, OPENAI_API_KEY=..., AI_MODEL=gpt-6-luna, AI_REASONING_EFFORT=xhigh.
OPENAI_API_KEY=
AI_TURN_TIMEOUT_MS=90000
AI_MAX_OUTPUT_TOKENS=8192
AI_MAX_PROVIDER_REQUESTS_PER_TURN=2
AI_SESSION_TURNS_PER_MINUTE=6
AI_DAILY_REQUEST_BUDGET=200
AI_REQUEST_BODY_BYTES=16384
STATE_DB_PATH=./var/piko.sqlite

# Za reverse proxy (Caddy, nginx): loopback albo liczba przeskoków. Puste = nie ufaj X-Forwarded-For.
TRUST_PROXY=

# Tylko `npm run desktop:dev`: adres backendu dla niespakowanej aplikacji Electron (np. http://127.0.0.1:3001/).
# Spakowana aplikacja tego nie czyta: adres HTTPS ustawia się przy budowie przez PIKO_DESKTOP_HTTPS_ORIGIN,
# a wariant z wbudowanym AI buduje się przez `npm run desktop:dist:ai`.
DESKTOP_API_BASE_URL=

# Opcjonalny kod udostępniany odbiorcy. Wyłącznie backend, 32–256 znaków.
# Ustaw JURY_ACCESS_REQUIRED=1 przy dostępie spoza listy IP.
JURY_ACCESS_REQUIRED=0
JURY_ACCESS_CODE=
