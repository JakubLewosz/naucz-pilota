# Konfiguracja backendu. Skopiuj do .env lokalnie; nie commituj sekretów.
NODE_ENV=development
SERVER_PORT=3001
PUBLIC_ORIGIN=http://127.0.0.1:5173

# Pierwsze uruchomienie jest jawnym demo. Zmień na live dopiero po konfiguracji.
AI_MODE=demo
AI_PROVIDER=openai
OPENAI_API_KEY=
AI_MODEL=
AI_TURN_TIMEOUT_MS=15000
AI_MAX_OUTPUT_TOKENS=1200
AI_MAX_PROVIDER_REQUESTS_PER_TURN=2
AI_SESSION_TURNS_PER_MINUTE=6
AI_DAILY_REQUEST_BUDGET=200
AI_REQUEST_BODY_BYTES=16384
STATE_DB_PATH=./var/piko.sqlite

# Desktop zna adres relay, nigdy klucz dostawcy.
# Produkcja: pełny adres HTTPS zaufanego backendu.
DESKTOP_API_BASE_URL=
